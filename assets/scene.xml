<mujoco model="pick_place_arm">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="RK4"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.15 0.15 0.15" rgb2="0.05 0.05 0.05" width="512" height="512"/>
    <material name="floor_mat" texture="grid" texrepeat="8 8" reflectance="0.15"/>
    <material name="table_mat" rgba="0.72 0.45 0.22 1"/>
    <material name="robot_mat" rgba="0.75 0.75 0.75 1"/>
    <material name="dark_mat" rgba="0.08 0.08 0.08 1"/>
    <material name="red_mat" rgba="0.9 0.05 0.04 1"/>
    <material name="blue_transparent" rgba="0.05 0.35 0.9 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 -3 4" dir="0 1 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor_mat"/>

    <body name="table" pos="0 0 0.05">
      <geom name="table_top" type="box" size="1.15 0.75 0.05" material="table_mat"/>
    </body>

    <!-- red cube with free joint -->
    <body name="red_cube" pos="0.55 -0.28 0.14">
      <freejoint name="cube_free"/>
      <geom name="red_cube_geom" type="box" size="0.055 0.055 0.055" material="red_mat" mass="0.04"/>
    </body>

    <!-- blue open box target -->
    <body name="blue_box" pos="-0.50 -0.18 0.12">
      <geom name="box_floor" type="box" size="0.16 0.16 0.015" material="blue_transparent" contype="0" conaffinity="0"/>
      <geom name="box_w1" type="box" pos="0 0.16 0.08" size="0.16 0.01 0.08" material="blue_transparent" contype="0" conaffinity="0"/>
      <geom name="box_w2" type="box" pos="0 -0.16 0.08" size="0.16 0.01 0.08" material="blue_transparent" contype="0" conaffinity="0"/>
      <geom name="box_w3" type="box" pos="0.16 0 0.08" size="0.01 0.16 0.08" material="blue_transparent" contype="0" conaffinity="0"/>
      <geom name="box_w4" type="box" pos="-0.16 0 0.08" size="0.01 0.16 0.08" material="blue_transparent" contype="0" conaffinity="0"/>
    </body>

    <!-- Robot: base yaw + shoulder + elbow + gripper -->
    <body name="robot_base" pos="0 0 0.10">
      <geom name="base_cylinder" type="cylinder" size="0.075 0.28" pos="0 0 0.28" material="robot_mat"/>
      <body name="yaw_link" pos="0 0 0.56">
        <joint name="base_yaw" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="2"/>
        <geom name="yaw_ball" type="sphere" size="0.07" material="robot_mat"/>

        <body name="upper_arm" pos="0 0 0">
          <joint name="shoulder" type="hinge" axis="0 1 0" range="-1.55 1.25" damping="2"/>
          <geom name="upper_geom" type="capsule" fromto="0 0 0 0.48 0 0" size="0.035" material="robot_mat"/>
          <body name="elbow_link" pos="0.48 0 0">
            <joint name="elbow" type="hinge" axis="0 1 0" range="-2.2 2.2" damping="2"/>
            <geom name="elbow_ball" type="sphere" size="0.055" material="robot_mat"/>
            <geom name="forearm_geom" type="capsule" fromto="0 0 0 0.38 0 0" size="0.03" material="robot_mat"/>
            <body name="gripper_base" pos="0.38 0 0">
              <site name="ee_site" pos="0.08 0 0" size="0.02" rgba="0 1 0 1"/>
              <geom name="palm" type="box" pos="0.04 0 0" size="0.06 0.04 0.025" material="dark_mat"/>
              <body name="left_finger" pos="0.08 0.05 -0.04">
                <joint name="gripper_left" type="slide" axis="0 1 0" range="-0.04 0.03" damping="1"/>
                <geom name="left_finger_geom" type="box" size="0.022 0.015 0.07" material="dark_mat"/>
              </body>
              <body name="right_finger" pos="0.08 -0.05 -0.04">
                <joint name="gripper_right" type="slide" axis="0 1 0" range="-0.03 0.04" damping="1"/>
                <geom name="right_finger_geom" type="box" size="0.022 0.015 0.07" material="dark_mat"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_base_yaw" joint="base_yaw" kp="180" ctrlrange="-3.14 3.14"/>
    <position name="act_shoulder" joint="shoulder" kp="180" ctrlrange="-1.55 1.25"/>
    <position name="act_elbow" joint="elbow" kp="180" ctrlrange="-2.2 2.2"/>
    <position name="act_gripper_left" joint="gripper_left" kp="120" ctrlrange="-0.04 0.03"/>
    <position name="act_gripper_right" joint="gripper_right" kp="120" ctrlrange="-0.03 0.04"/>
  </actuator>
</mujoco>
